# Maintainer: rainey <rainey@noreply.github.com>

pkgname=jaybird
pkgver=26.02
pkgrel=1
pkgdesc="Virtual modular synthesizer with configurable module selection (Cardinal fork)"
arch=(x86_64)
url="https://github.com/rainey/JayBird"
license=(GPL-3.0-or-later)
# Module selection profile: any profile name from kconfig/configs/ in the
# source tree (default, test), or a path to your own .config file.
# Override at build time:  _jaybird_config=test makepkg
# The built package is functionally identical to Cardinal with a subset of
# modules compiled in; build-all is the default profile.
_jaybird_config="${_jaybird_config:-default}"
depends=(
  alsa-lib
  carla
  dbus
  file
  fftw
  gcc-libs
  jansson
  libarchive
  libglvnd
  liblo
  libsamplerate
  libsndfile
  libx11
  libxext
  libxrandr
  libxcursor
  speexdsp
  jack
)
makedepends=(
  cmake
  file
  python-yaml
)
optdepends=(
  'python-kconfiglib: interactive module selection (make menuconfig)'
)
provides=(jaybird)
conflicts=(jaybird)
options=(!lto)
# Tarball release flow: source = jaybird+deps tarball (submodule contents +
# Rack dep sources pre-merged, mirrors upstream Cardinal's release tarballs).
# Regenerate with `make jaybird-tarball` from a pristine checkout; update the
# hash below per release.
source=("jaybird+deps-$pkgver.tar.xz")
sha256sums=('2730d9c9b1945f8dd3fae4575e70425dda6431c1a5b1fc96d9ddf71dd93ffae6')

prepare() {
  cd "jaybird-$pkgver"

  # Module selection: honor an external config path by copying it into the
  # tree as a profile named after its file stem.
  if [[ -f "$_jaybird_config" ]]; then
    install -Dm644 "$_jaybird_config" \
      "kconfig/configs/aur-$(basename "${_jaybird_config%.config}").config"
    export _jaybird_config="aur-$(basename "${_jaybird_config%.config}")"
  fi
}

build() {
  export CONFIG="$_jaybird_config"
  # NOTE: PREFIX must be set at build time, not only install time
  make SYSDEPS=true PREFIX=/usr all
}

check() {
  cd "jaybird-$pkgver"
  # The lv2 TTL generation instantiates every registered plugin headlessly;
  # a filtered module selection that breaks registration fails here.
  make SYSDEPS=true PREFIX=/usr gen
}

package() {
  cd "jaybird-$pkgver"
  make SYSDEPS=true PREFIX=/usr DESTDIR="$pkgdir" install

  # CardinalNative is a developer test tool (per upstream packaging)
  rm -f "$pkgdir/usr/bin/CardinalNative"

  install -Dm644 README.md -t "$pkgdir/usr/share/doc/jaybird/"
  install -Dm644 docs/FORK-NOTES.md -t "$pkgdir/usr/share/doc/jaybird/"
}
