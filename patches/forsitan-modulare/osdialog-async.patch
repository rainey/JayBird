@@ -395,12 +395,25 @@ struct PelliculaWidget : ModuleWidget {
         menu->addChild(createMenuLabel(folder.empty() ? "Kits folder: (not set)"
                                                       : "Kits folder: " + folder));
         menu->addChild(createMenuItem("Set kits folder…", "", [=]() {
+#ifdef USING_CARDINAL_NOT_RACK
+            // Cardinal has no blocking osdialog (and no directory picker in
