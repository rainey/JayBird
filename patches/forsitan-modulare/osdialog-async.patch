@@ -1076,7 +1087,21 @@ struct LimenWidget : ModuleWidget {
 		// Pending zoom_to_modules: run on consecutive frames until the layout
 		// has settled, so the final fit is correctly centred.
 		if (m->zoomFrames.load() > 0) {
+#ifdef USING_CARDINAL_NOT_RACK
+			// Cardinal's Rack fork has no RackScrollWidget::zoomToModules();
+			// reimplement the fit: zoom to the module bounding box, centred.
+			rack::app::RackScrollWidget* rs = APP->scene->rackScroll;
+			math::Rect bb = rs->rackWidget->getChildrenBoundingBox();
+			if (bb.size.x > 0.f && bb.size.y > 0.f) {
+				math::Vec viewport = rs->box.size.div(rs->getZoom());
+				float zoom = std::min(viewport.x / bb.size.x, viewport.y / bb.size.y);
+				zoom = clamp(zoom, std::min(rs->getZoom(), 1.0f), 4.0f);
+				rs->setZoom(zoom, bb.getCenter());
+				rs->setGridOffset(bb.pos.minus(viewport.minus(bb.size).mult(0.5f)));
+			}
+#else
 			APP->scene->rackScroll->zoomToModules();
+#endif
 			m->zoomFrames--;
 		}
 	}
diff --git a/src/pellicula.cpp b/src/pellicula.cpp
